    "@types/node": "^22.14.0",
    "@types/papaparse": "^5.5.2",
    "esbuild": "^0.28.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2"
  },
